NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
# Contact/primary designation only; Developer authorization always requires trusted database state.
DEVELOPER_EMAIL=ruban.peppin@caedm.ca
DEVELOPER_NAME=Ruban Peppin
# Signed Resend delivery callbacks for provider-confirmed announcement status.
RESEND_WEBHOOK_SECRET=
# Server only. Required for production authentication throttling, invitations, and reminder delivery.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
EMAIL_PROVIDER=local
# Production: EMAIL_PROVIDER=resend. Server-only; never NEXT_PUBLIC_.
RESEND_API_KEY=
# Resend is primary. Use Exchange only after an explicit rejection; timeouts stay on Resend.
EMAIL_SMTP_FALLBACK=true
# HTTP Send Email hook secret from Supabase, including its v1,whsec_ prefix.
SUPABASE_SEND_EMAIL_HOOK_SECRET=
# Used only for optional legacy SMTP. Resend uses purpose-specific CAEDM senders.
EMAIL_FROM=CAEDM Software Hub <notifications@caedm.ca>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Local PostgreSQL test/seed target; do not point at production.
DATABASE_URL=
